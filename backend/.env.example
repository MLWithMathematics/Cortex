# Copy this file to .env and fill in your values
# cp .env.example .env

# ── AI Provider Keys ────────────────────────────────────────────────────────

# Google Gemini API key (used for: resume parsing, session assessment)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (used for: real-time question generation during interviews)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Database ────────────────────────────────────────────────────────────────

# Optional: defaults to local SQLite
# DATABASE_URL=sqlite:///./screening.db
# DATABASE_URL=postgresql://user:password@localhost:5432/screening
